# Aether tablet driver -- udev rules.
# Generated from OpenTabletDriver 0.6.7 device configurations.
# Grants the seat-owner uaccess to /dev/uinput and to the matching
# /dev/hidraw* nodes for every supported tablet.

KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess", TAG+="udev-acl"
KERNEL=="js[0-9]*", SUBSYSTEM=="input", ATTRS{name}=="AetherService Virtual*", RUN+="/usr/bin/env rm %E{DEVNAME}"
SUBSYSTEM=="input", ATTRS{name}=="AetherService Virtual*", ENV{LIBINPUT_DEVICE_GROUP}="AetherService"

# Classify our uinput devices for libinput. Without ID_INPUT_TABLET on
# the virtual pen, libinput's tablet code never picks it up on Wayland,
# which is why the pen-driven cursor didn't move at all under Hyprland /
# GNOME / KDE Wayland.
SUBSYSTEM=="input", ATTRS{name}=="AetherService Virtual Pen", ENV{ID_INPUT}="1", ENV{ID_INPUT_TABLET}="1"
SUBSYSTEM=="input", ATTRS{name}=="AetherService Virtual Mouse", ENV{ID_INPUT}="1", ENV{ID_INPUT_MOUSE}="1"

# Genius G-Pen 560
KERNEL=="hidraw*", ATTRS{idVendor}=="0458", ATTRS{idProduct}=="5003", TAG+="uaccess", TAG+="udev-acl"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0458", ATTRS{idProduct}=="5003", TAG+="uaccess", TAG+="udev-acl"
SUBSYSTEM=="input", ATTRS{idVendor}=="0458", ATTRS{idProduct}=="5003", ENV{LIBINPUT_IGNORE_DEVICE}="1"

# Genius i405x
KERNEL=="hidraw*", ATTRS{idVendor}=="0458", ATTRS{idProduct}=="5010", TAG+="uaccess", TAG+="udev-acl"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0458", ATTRS{idProduct}=="5010", TAG+="uaccess", TAG+="udev-acl"

# Genius i608x
KERNEL=="hidraw*", ATTRS{idVendor}=="0458", ATTRS{idProduct}=="501a", TAG+="uaccess", TAG+="udev-acl"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0458", ATTRS{idProduct}=="501a", TAG+="uaccess", TAG+="udev-acl"

# RobotPen T9A
KERNEL=="hidraw*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="6003", TAG+="uaccess", TAG+="udev-acl"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="6003", TAG+="uaccess", TAG+="udev-acl"
SUBSYSTEM=="input", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="6003", ENV{LIBINPUT_IGNORE_DEVICE}="1"

